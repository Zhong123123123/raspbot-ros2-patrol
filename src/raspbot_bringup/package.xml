<?xml version="1.0"?>
<package format="3">
  <name>raspbot_bringup</name>
  <version>0.0.1</version>
  <description>Launch files for Yahboom Raspbot ROS 2 bringup.</description>
  <maintainer email="ubuntu@localhost">ubuntu</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>raspbot_base</exec_depend>
  <exec_depend>raspbot_vision</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
